class Solution {
public:
    vector<int> sortArrayByParity(vector<int>& nums) {

        int left = 0;
        int right = nums.size() - 1;

        while(left < right) {

            // left ko odd par rokna hai
            if(nums[left] % 2 == 0) {
                left++;
            }

            // right ko even par rokna hai
            else if(nums[right] % 2 != 0) {
                right--;
            }

            // left = odd, right = even
            else {
                swap(nums[left], nums[right]);
                left++;
                right--;
            }
        }

        return nums;
    }
};