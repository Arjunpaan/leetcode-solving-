class Solution {
public:
    int minEatingSpeed(vector<int>& piles, int h) {
        

        int low = 1;
        int high =*max_element(piles.begin(), piles.end());
        int n = piles.size();

        while(low < high){
            int hours = 0;

            int mid = (low + high) / 2;
            for(int i=0; i<n;i++){
                hours += piles[i] / mid;

                if(piles[i] % mid != 0)
                    hours++;
            }
            if(hours>h){
                low=mid+1;
            }
            else{
                high=mid;
            }
            
            
        }

        return low;
        
    }
};