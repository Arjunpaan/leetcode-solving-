class Solution {
public:
    int findMin(vector<int>& nums) {

        int low = 0;
        int high = nums.size() - 1;

        while(low < high){

            int mid = (low + high) / 2;

            // minimum lies right side
            if(nums[mid] > nums[high]){
                low = mid + 1;
            }

            // minimum lies left side including mid
            else{
                high = mid;
            }
        }

        return nums[low];
    }
};