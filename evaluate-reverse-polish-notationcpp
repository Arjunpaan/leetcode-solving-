class Solution {
public:
    int evalRPN(vector<string>& tokens) {

        stack<int> st;
        int n = tokens.size();
        int i = 0;

        while (i < n) {

            if (tokens[i] == "+") {
                int b = st.top();
                st.pop();

                int a = st.top();
                st.pop();

                st.push(a + b);
            }

            else if (tokens[i] == "-") {
                int b = st.top();
                st.pop();

                int a = st.top();
                st.pop();

                st.push(a - b);
            }

            else if (tokens[i] == "*") {
                int b = st.top();
                st.pop();

                int a = st.top();
                st.pop();

                st.push(a * b);
            }

            else if (tokens[i] == "/") {
                int b = st.top();
                st.pop();

                int a = st.top();
                st.pop();

                st.push(a / b);
            }

            else {
                st.push(stoi(tokens[i]));
            }

            i++;
        }

        return st.top();
    }
};