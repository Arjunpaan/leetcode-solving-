class Solution {
public:
    int shipWithinDays(vector<int>& weights, int days) {
        int low = *max_element(weights.begin(), weights.end());
        int i=0;
        int n=weights.size();
        int sum=0;

        while(i<n){
            sum+=weights[i];
            i++;
        }
        int high=sum;


        //int high = *max_element(nums.begin(), nums.end());

        while(low < high){

            int mid = low + (high - low) / 2;

            int d = 1;
            int ts = 0;

            for(int i = 0; i < weights.size(); i++){

                if(ts + weights[i] <= mid){
                    ts += weights[i];
                }
                else{
                    d++;
                    ts = weights[i];
                }
            }

            if(d <= days){
                high = mid;
            }
            else{
                low = mid + 1;
            }
        }

        return low;
    
    }
};


