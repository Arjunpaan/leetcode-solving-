class Solution {
public:
    int mySqrt(int x) {

        int ans = 0;
        long long i = 0;

        while (i * i <= x) {

            if (i * i == x) {
                return i;
            }

            if (i * i < x && x < (i + 1) * (i + 1)) {
                ans = i;
                break;
            }

            i++;
        }

        return ans;
    }
};