/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode(int x) : val(x), next(NULL) {}
 * };
 */
class Solution {
public:
    ListNode *getIntersectionNode(ListNode *headA, ListNode *headB) {

        ListNode* a = headA;
        ListNode* b = headB;

        int p = 0;
        int q = 0;
        int s = 0;

        while(a != nullptr) {
            p += 1;
            a = a->next;
        }

        while(b != nullptr) {
            q += 1;
            b = b->next;
        }

        a = headA;
        b = headB;

        if(p > q) {

            s = p - q;

            for(int i = 0; i < s; i++) {
                a = a->next;
            }
        }

        else if(q > p) {

            s = q - p;

            for(int i = 0; i < s; i++) {
                b = b->next;
            }
        }

        while(a != nullptr && b != nullptr) {

            if(a == b) {
                return a;
            }

            a = a->next;
            b = b->next;
        }

        return nullptr;
    }
};