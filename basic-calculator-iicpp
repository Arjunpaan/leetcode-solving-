class Solution {
public:
    int calculate(string s) {

        stack<int> st;

        int num = 0;
        char op = '+';

        for (int i = 0; i < s.length(); i++) {

            // number bana rahe hain
            if (isdigit(s[i])) {
                num = num * 10 + (s[i] - '0');
            }

            // operator mila OR last character hai
            if ((!isdigit(s[i]) && s[i] != ' ') || i == s.length() - 1) {

                if (op == '+') {
                    st.push(num);
                }
                else if (op == '-') {
                    st.push(-num);
                }
                else if (op == '*') {
                    int x = st.top();
                    st.pop();

                    st.push(x * num);
                }
                else if (op == '/') {
                    int x = st.top();
                    st.pop();

                    st.push(x / num);
                }

                // current operator save karo
                op = s[i];

                // next number ke liye reset
                num = 0;
            }
        }

        int ans = 0;

        while (!st.empty()) {
            ans += st.top();
            st.pop();
        }

        return ans;
    }
};